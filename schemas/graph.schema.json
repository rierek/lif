{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/graphModel",
  "$defs": {
    "graphEdge": {
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "from",
        "to",
        "relation"
      ]
    },
    "graphModel": {
      "properties": {
        "nodes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/graphNode"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "edges": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/graphEdge"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object",
      "required": [
        "nodes",
        "edges"
      ]
    },
    "graphNode": {
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "id",
        "title",
        "status"
      ]
    }
  }
}
