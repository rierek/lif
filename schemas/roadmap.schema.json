{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Data",
  "$defs": {
    "Container": {
      "properties": {
        "epic": {
          "$ref": "#/$defs/EpicGroup"
        },
        "feature": {
          "$ref": "#/$defs/FeatureGroup"
        }
      },
      "type": "object"
    },
    "Data": {
      "properties": {
        "root": {
          "$ref": "#/$defs/RootGroup"
        },
        "milestones": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/MilestoneGroup"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "unscheduled": {
          "$ref": "#/$defs/UnscheduledGroup"
        }
      },
      "type": "object",
      "required": [
        "milestones"
      ]
    },
    "EpicGroup": {
      "properties": {
        "epic": {
          "$ref": "#/$defs/Item"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        },
        "features": {
          "items": {
            "$ref": "#/$defs/FeatureGroup"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "epic"
      ]
    },
    "FeatureGroup": {
      "properties": {
        "feature": {
          "$ref": "#/$defs/Item"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "feature"
      ]
    },
    "Item": {
      "properties": {
        "id": {
          "type": "string",
          "description": "ID is the unique NanoID identifier (from filename)."
        },
        "slug": {
          "type": "string",
          "description": "Slug is the optional human-readable part of the filename."
        },
        "path": {
          "type": "string",
          "description": "Path is the relative path from .beans/ root (e.g., \"epic-auth/abc123-login.md\")."
        },
        "title": {
          "type": "string",
          "description": "Title is the human-readable title."
        },
        "status": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "order": {
          "type": "string",
          "description": "Order is a fractional index string for manual sorting."
        },
        "body": {
          "type": "string",
          "description": "Body is the markdown content after the front matter."
        },
        "parent": {
          "type": "string",
          "description": "Parent is the optional parent item ID (milestone, epic, or feature)."
        },
        "blocking": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Blocking is a list of item IDs that this item is blocking."
        },
        "blocked_by": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "BlockedBy is a list of item IDs that are blocking this item."
        },
        "extra": {
          "type": "object",
          "description": "Extra holds front matter keys not covered by any typed field above."
        },
        "etag": {
          "type": "string",
          "description": "Hash of the item file; the value --if-match expects."
        }
      },
      "type": "object",
      "required": [
        "id",
        "path",
        "title",
        "status",
        "etag"
      ],
      "title": "Item",
      "description": "An item as printed by show, create, update, list and the other item verbs."
    },
    "MilestoneGroup": {
      "properties": {
        "milestone": {
          "$ref": "#/$defs/Item"
        },
        "containers": {
          "items": {
            "$ref": "#/$defs/Container"
          },
          "type": "array"
        },
        "other": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "milestone"
      ]
    },
    "RootGroup": {
      "properties": {
        "epic": {
          "$ref": "#/$defs/EpicGroup"
        },
        "feature": {
          "$ref": "#/$defs/FeatureGroup"
        }
      },
      "type": "object"
    },
    "UnscheduledGroup": {
      "properties": {
        "containers": {
          "items": {
            "$ref": "#/$defs/Container"
          },
          "type": "array"
        },
        "other": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "type": "array"
        }
      },
      "type": "object"
    }
  }
}
