Source common.tape
# Screenshots brechen mit gesetzter Framerate ab, daher nur in GIF-Tapes.
Set Framerate 15
Output tui-roadmap-navigation.gif
Set TypingSpeed 0
Sleep 800ms
Type "l"
Sleep 700ms
Type "zo"
Sleep 900ms
Down 2
Type "]"
Sleep 700ms
Type "]"
Sleep 700ms
Type "["
Sleep 700ms
Type "zc"
Sleep 700ms
Type "zR"
Sleep 1s
Type "zM"
Sleep 1s
