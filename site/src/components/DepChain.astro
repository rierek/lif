---
// Blocked/ready chain for one dependency edge: before and after the blocker is completed.
// Items match the example on the Dependencies page (ft-957g blocks ft-o87g).
import { CircleCheck, ArrowRight, Lock, Play } from '@lucide/astro';
---

<div class="chains not-content">
	<div class="row">
		<span class="step">Before</span>
		<div class="node ready"><Play size={16} aria-hidden="true" /><b>ft-957g</b> Send reset mail <em>ready</em></div>
		<span class="edge"><span>blocks</span><ArrowRight size={18} aria-hidden="true" /></span>
		<div class="node blocked"><Lock size={16} aria-hidden="true" /><b>ft-o87g</b> Reset page <em>blocked</em></div>
	</div>
	<div class="row">
		<span class="step">After <code>lif complete ft-957g</code></span>
		<div class="node done"><CircleCheck size={16} aria-hidden="true" /><b>ft-957g</b> Send reset mail <em>completed</em></div>
		<span class="edge"><span>released</span><ArrowRight size={18} aria-hidden="true" /></span>
		<div class="node ready"><Play size={16} aria-hidden="true" /><b>ft-o87g</b> Reset page <em>ready</em></div>
	</div>
</div>

<style>
	.chains { display: flex; flex-direction: column; gap: 1rem; margin-block: 1.5rem; padding: 1rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; background: var(--term-bg); }
	.row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
	.step { flex: 0 0 100%; font-size: var(--sl-text-xs); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--sl-color-gray-3); }
	.step code { text-transform: none; letter-spacing: 0; background: none; padding: 0; }
	.node { display: inline-flex; align-items: center; gap: 0.45rem; padding: 0.4rem 0.8rem; border-radius: 0.5rem; border: 1px solid; font-size: var(--sl-text-sm); color: var(--sl-color-white); background: var(--sl-color-bg); }
	.node b { font-family: var(--sl-font-mono); font-weight: 600; }
	.node em { font-style: normal; font-size: var(--sl-text-xs); padding: 0 0.4rem; border-radius: 999px; border: 1px solid currentColor; }
	.ready { border-color: var(--sl-color-green); } .ready :global(svg), .ready em { color: var(--sl-color-green); }
	.blocked { border-color: var(--sl-color-red); } .blocked :global(svg), .blocked em { color: var(--sl-color-red); }
	.done { border-color: var(--sl-color-gray-3); } .done :global(svg), .done em { color: var(--sl-color-gray-2); }
	.edge { display: inline-flex; flex-direction: column; align-items: center; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
</style>
