---
// Pill segmented control (icon + label) that switches panels, in the style of usememos.com.
// Each tab has a short caption (HTML allowed) plus the slot named after its id. Roving tabindex, arrow keys, Home/End.
interface Tab {
	id: string;
	label: string;
	icon?: any;
	caption: string;
}
interface Props {
	label: string;
	tabs: Tab[];
}
const { label, tabs } = Astro.props;
const uid = label.toLowerCase().replace(/\W+/g, '-');
---

<feature-tabs class="tabs not-content">
	<div class="list" role="tablist" aria-label={label}>
		{tabs.map((t, i) => {
			const Icon = t.icon;
			return (
				<button type="button" role="tab" id={`${uid}-tab-${t.id}`} aria-controls={`${uid}-panel-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
					{Icon && <Icon size={16} aria-hidden="true" />}<span>{t.label}</span>
				</button>
			);
		})}
	</div>
	{tabs.map((t, i) => (
		<div class="panel" role="tabpanel" id={`${uid}-panel-${t.id}`} aria-labelledby={`${uid}-tab-${t.id}`} hidden={i !== 0}>
			<p class="caption" set:html={t.caption} />
			<slot name={t.id} />
		</div>
	))}
</feature-tabs>

<script>
	class FeatureTabs extends HTMLElement {
		connectedCallback() {
			const tabs = [...this.querySelectorAll<HTMLElement>('[role=tab]')];
			const panels = tabs.map((t) => this.querySelector<HTMLElement>(`#${t.getAttribute('aria-controls')}`)!);
			const select = (i: number, focus = false) => {
				tabs.forEach((t, j) => {
					t.setAttribute('aria-selected', String(i === j));
					t.tabIndex = i === j ? 0 : -1;
					panels[j].hidden = i !== j;
				});
				if (focus) tabs[i].focus();
			};
			tabs.forEach((t, i) => {
				t.addEventListener('click', () => select(i));
				t.addEventListener('keydown', (e) => {
					const to = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
					if (to === undefined) return;
					e.preventDefault();
					select((to + tabs.length) % tabs.length, true);
				});
			});
		}
	}
	customElements.define('feature-tabs', FeatureTabs);
</script>

<style>
	.tabs { display: block; }
	.list { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.375rem; width: fit-content; max-width: 100%; margin: 0 auto; padding: 0.375rem; border: 1px solid var(--sl-color-gray-5); border-radius: 1rem; background: var(--sl-color-gray-6); }
	button { display: inline-flex; align-items: center; gap: 0.5rem; height: 2.25rem; padding: 0 0.9rem; border: 0; border-radius: 0.75rem; font: inherit; font-size: var(--sl-text-sm); font-weight: 500; color: var(--sl-color-gray-2); background: transparent; cursor: pointer; transition: color 0.15s, background-color 0.15s; }
	button:hover { color: var(--sl-color-white); }
	button[aria-selected='true'] { background: var(--sl-color-white); color: var(--sl-color-black); }
	button:focus-visible { outline: 2px solid var(--sl-color-accent-high); outline-offset: 2px; }
	@media (max-width: 30rem) { .list { gap: 0.25rem; padding: 0.3rem; } button { gap: 0.35rem; padding: 0 0.55rem; font-size: 0.8rem; } }
	.panel { margin-top: 1.5rem; }
	.caption { max-width: 38rem; margin: 0 auto 1.5rem; text-align: center; line-height: 1.7; color: var(--sl-color-gray-2); }
	.caption :global(code) { font-size: 0.9em; padding: 0.1em 0.4em; border-radius: 0.3rem; background: var(--sl-color-gray-5); color: var(--sl-color-white); }
</style>
