---
// Split hero in the style of usememos.com: two-line headline (second line in accent), pitch, check-mark bullets,
// two buttons, and a visual (terminal window) on the right. Default slot = pitch, slot "visual" = right side.
import { Check } from '@lucide/astro';

interface Link {
	text: string;
	href: string;
}
interface Props {
	title: string;
	accent: string;
	checks?: string[];
	primary: Link;
	secondary?: Link;
}
const { title, accent, checks = [], primary, secondary } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="hero not-content">
	<div class="copy">
		<h1 id="_top"><span>{title}</span> <span class="accent">{accent}</span></h1>
		<div class="pitch"><slot /></div>
		{checks.length > 0 && (
			<ul class="checks">{checks.map((c) => <li><Check size={16} aria-hidden="true" />{c}</li>)}</ul>
		)}
		<div class="actions">
			<a class="btn primary" href={base + primary.href}>{primary.text}</a>
			{secondary && <a class="btn" href={base + secondary.href}>{secondary.text}</a>}
		</div>
	</div>
	<div class="visual"><slot name="visual" /></div>
</section>

<script is:inline>
	// Hero typing moment: set the step count to the command length so each step reveals one character.
	document.querySelectorAll('.hero .cmd').forEach((el) => el.style.setProperty('--n', el.textContent.length));
</script>

<style>
	.hero { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: center; padding-block: clamp(2rem, 6vw, 5rem) 0; }
	/* Hero typing moment (VISUAL-SYSTEM 5): the prompt line types its command, then the output appears at once.
	   Text stays in the DOM and keeps its layout space; reduced motion renders the final state. */
	@media (prefers-reduced-motion: no-preference) {
		.visual :global(.cmd) { display: inline-block; vertical-align: top; animation: type 600ms steps(var(--n, 20), end) both; }
		.visual :global(.out) { animation: reveal 0s 600ms both; }
	}
	@keyframes type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0); } }
	@keyframes reveal { from { opacity: 0; } to { opacity: 1; } }
	@media (min-width: 64rem) { .hero { grid-template-columns: minmax(0, 4fr) minmax(0, 6fr); gap: 3rem; } }
	h1 { margin: 0; font-size: clamp(2rem, 7vw, 2.75rem); line-height: 1.08; letter-spacing: -0.04em; font-weight: 700; color: var(--lif-ink-strong); }
	h1 span { display: block; }
	@media (min-width: 64rem) { h1 { font-size: clamp(2rem, 3.8vw, 2.75rem); } }
	h1 .accent { color: var(--lif-accent-ink); }
	.pitch { margin-top: 1.5rem; font-size: var(--sl-text-base); line-height: 1.7; color: var(--lif-ink); max-width: 34rem; }
	.pitch :global(p) { margin: 0; }
	.checks { list-style: none; margin: 1.5rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: var(--sl-text-sm); color: var(--lif-ink); }
	.checks li { display: flex; align-items: center; gap: 0.4rem; }
	.checks :global(svg) { color: var(--lif-accent-ink); flex: none; }
	.actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
	.btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.7rem 1.25rem; border: 1px solid var(--lif-rule); border-radius: 0.5rem; font-size: var(--sl-text-sm); font-weight: 700; text-decoration: none; color: var(--lif-ink); background: transparent; transition: background-color 0.15s ease-out, border-color 0.15s ease-out; }
	.btn:hover { background: var(--lif-accent-tint); border-color: var(--lif-accent-ink); }
	.btn.primary { background: var(--lif-ink); border-color: var(--lif-ink); color: var(--lif-page); }
	.btn.primary:hover { background: var(--lif-accent-fill); border-color: var(--lif-accent-fill); color: var(--lif-on-accent); }
	.btn:focus-visible { outline: 2px solid var(--lif-accent-ink); outline-offset: 2px; }
	@media (max-width: 30rem) { .btn { width: 100%; } }
</style>
