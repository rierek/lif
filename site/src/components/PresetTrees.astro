---
// The four shipped presets as type hierarchies (source: Reference, Configuration, Presets).
// Each row is one rank level. A child needs a strictly greater rank than its parent.
interface Level { rank: number; types: { name: string; hidden?: boolean }[] }
const presets: { name: string; note: string; levels: Level[] }[] = [
	{ name: 'classic', note: '4 levels', levels: [
		{ rank: 1, types: [{ name: 'milestone' }] },
		{ rank: 2, types: [{ name: 'epic' }] },
		{ rank: 3, types: [{ name: 'feature' }] },
		{ rank: 4, types: [{ name: 'bug' }, { name: 'task' }] },
	] },
	{ name: 'todo', note: '1 level', levels: [{ rank: 4, types: [{ name: 'task' }] }] },
	{ name: 'simple', note: '3 levels', levels: [
		{ rank: 1, types: [{ name: 'milestone' }, { name: 'bucket', hidden: true }] },
		{ rank: 2, types: [{ name: 'epic' }, { name: 'feature' }] },
		{ rank: 4, types: [{ name: 'bug' }, { name: 'task' }] },
	] },
	{ name: 'complex', note: '3 levels', levels: [
		{ rank: 1, types: [{ name: 'release' }, { name: 'bucket', hidden: true }] },
		{ rank: 2, types: [{ name: 'feature' }, { name: 'improvement' }, { name: 'chore' }] },
		{ rank: 4, types: [{ name: 'story' }, { name: 'bug' }, { name: 'task' }] },
	] },
];
---

<div class="presets not-content">
	{presets.map((p) => (
		<section class="preset">
			<header><code>{p.name}</code><span>{p.note}</span></header>
			<ol>
				{p.levels.map((l) => (
					<li>
						<span class="rank" title="rank">{l.rank}</span>
						<span class="types">
							{l.types.map((t) => <span class:list={['chip', { hidden: t.hidden }]} title={t.hidden ? 'roadmap: false' : undefined}>{t.name}</span>)}
						</span>
					</li>
				))}
			</ol>
		</section>
	))}
	<p class="legend"><span class="chip">type</span> a type, the number is its rank. <span class="chip hidden">type</span> <code>roadmap: false</code>: hidden from <code>lif roadmap</code>. A parent needs a lower rank than its child.</p>
</div>

<style>
	.presets { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; margin-block: 1.5rem; }
	.preset { border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; background: var(--term-bg); overflow: hidden; }
	header { display: flex; justify-content: space-between; align-items: baseline; padding: 0.55rem 0.9rem; background: var(--term-bar); border-bottom: 1px solid var(--sl-color-gray-5); }
	header code { color: var(--sl-color-accent-high); font-weight: 600; background: none; padding: 0; }
	header span { font-size: var(--sl-text-xs); color: var(--sl-color-gray-3); }
	ol { list-style: none; margin: 0; padding: 0.8rem 0.9rem; display: flex; flex-direction: column; gap: 0.7rem; }
	li { display: flex; align-items: center; gap: 0.6rem; position: relative; margin: 0; }
	li:not(:last-child)::after { content: ''; position: absolute; left: 0.8rem; top: 1.75rem; height: 0.75rem; border-left: 2px solid var(--sl-color-gray-4); }
	.rank { flex: none; display: grid; place-items: center; width: 1.6rem; height: 1.6rem; border-radius: 50%; border: 1px solid var(--sl-color-gray-4); font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); }
	.types { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.chip { display: inline-block; padding: 0.1rem 0.55rem; border-radius: 999px; border: 1px solid var(--sl-color-accent); background: var(--sl-color-accent-low); color: var(--sl-color-white); font-size: var(--sl-text-xs); font-family: var(--sl-font-mono); }
	.chip.hidden { border-style: dashed; border-color: var(--sl-color-gray-3); background: transparent; color: var(--sl-color-gray-2); }
	.legend { grid-column: 1 / -1; margin: 0; font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
	.legend code { background: none; padding: 0; }
</style>
