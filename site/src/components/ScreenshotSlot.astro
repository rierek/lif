---
// Placeholder for a real screenshot (D70). Same border look as TerminalWindow. Replace with an image in phase 5.4.
interface Props {
	caption: string;
	ratio?: string;
}
const { caption, ratio = '16 / 10' } = Astro.props;
---

<figure class="slot not-content" data-pagefind-ignore>
	<div class="frame" style={`aspect-ratio: ${ratio}`}>
		<span class="label">Screenshot follows</span>
	</div>
	<figcaption>{caption}</figcaption>
</figure>

<style>
	.slot { margin: 0; border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; overflow: hidden; background: var(--term-bg); box-shadow: 0 1.5rem 3rem -1.5rem var(--sl-color-gray-7); }
	.frame { display: grid; place-items: center; background: repeating-linear-gradient(135deg, transparent 0 0.9rem, var(--sl-color-gray-6) 0.9rem 1rem); }
	.label { padding: 0.25rem 0.8rem; border: 1px dashed var(--sl-color-gray-4); border-radius: 999px; font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); background: var(--term-bg); }
	figcaption { padding: 0.6rem 0.9rem; border-top: 1px solid var(--sl-color-gray-5); background: var(--term-bar); font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); }
</style>
