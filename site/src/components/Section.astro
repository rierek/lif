---
// Home page section: centered heading, content below, optional "read more" link.
interface Props {
	title: string;
	link?: { text: string; href: string };
}
const { title, link } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section">
	<header class="not-content">
		<h2>{title}</h2>
	</header>
	<slot />
	{link && (
		<p class="more not-content"><a href={base + link.href}>{link.text}</a></p>
	)}
</section>

<style>
	.section { margin-block: clamp(3.5rem, 8vw, 6rem) 0; }
	header { text-align: center; margin-bottom: 2rem; }
	h2 { margin: 0; font-size: clamp(1.6rem, 3.2vw, 2.4rem); line-height: 1.15; letter-spacing: -0.03em; color: var(--lif-ink-strong); }
	.more { margin: 2.5rem 0 0; max-width: none; text-align: center; }
	.more a { font-size: var(--sl-text-sm); font-weight: 700; color: var(--lif-accent-ink); text-underline-offset: 0.2em; }
	.more a:hover { color: var(--lif-ink-strong); }
</style>
