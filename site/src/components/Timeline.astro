---
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entries = (await getCollection('docs'))
	.filter((e) => e.id.startsWith('releases/') && e.id !== 'releases' && e.data.date)
	.sort((a, b) => +b.data.date! - +a.data.date!);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---

<ol class="timeline not-content">
	{entries.map((e) => (
		<li>
			<time datetime={e.data.date!.toISOString()}>{fmt(e.data.date!)}</time>
			<span class="dot" aria-hidden="true"></span>
			<article class="card">
				<h3>{e.data.title}</h3>
				<p>{e.data.teaser}</p>
				<footer>
					<a href={`${base}/${e.id}/`}>Read more →</a>
					<span>{e.data.minRead ?? 1} min read</span>
				</footer>
			</article>
		</li>
	))}
</ol>

<style>
	.timeline { list-style: none; margin: 2rem 0; padding: 0; }
	li { display: grid; grid-template-columns: 7.5rem 1.5rem 1fr; column-gap: 1rem; position: relative; padding-bottom: 1.5rem; }
	li::before { content: ''; position: absolute; left: calc(7.5rem + 1rem + 0.75rem - 1px); top: 1.4rem; bottom: -0.4rem; width: 2px; background: var(--sl-color-gray-5); }
	li:last-child::before { display: none; }
	time { text-align: right; color: var(--sl-color-gray-3); font-size: var(--sl-text-sm); padding-top: 0.9rem; }
	.dot { width: 0.8rem; height: 0.8rem; margin: 1rem auto 0; border-radius: 50%; background: var(--sl-color-accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 25%, transparent); z-index: 1; }
	.card { padding: 1rem 1.25rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; }
	h3 { margin: 0 0 0.5rem; font-size: var(--sl-text-xl); color: var(--sl-color-white); }
	p { margin: 0; color: var(--sl-color-gray-2); }
	footer { display: flex; justify-content: space-between; align-items: center; margin-top: 1rem; font-size: var(--sl-text-sm); }
	footer a { color: var(--sl-color-accent-high); text-decoration: none; font-weight: 700; }
	footer span { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
	@media (max-width: 50rem) { li { grid-template-columns: 1.5rem 1fr; } time { grid-column: 2; text-align: left; padding: 0; } .dot { grid-row: 1 / 3; grid-column: 1; } .card { grid-column: 2; } li::before { left: 0.75rem; } }
</style>
